{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-pipeline/job-assessment.schema.json",
  "title": "Evidence-backed job assessment",
  "type": "object",
  "required": [
    "disposition",
    "role_to_profile_fit",
    "strengths",
    "gaps",
    "uncertainties"
  ],
  "properties": {
    "disposition": {
      "enum": ["strong_match", "worth_considering", "non_match"]
    },
    "role_to_profile_fit": {"type": "string", "minLength": 1},
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile_evidence_id", "claim"]
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
    },
    "profile_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "criteria_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
