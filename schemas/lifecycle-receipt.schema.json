{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-pipeline/lifecycle-receipt.schema.json",
  "title": "Minimal lifecycle evidence receipt",
  "type": "object",
  "required": [
    "source_kind",
    "source_receipt_hash",
    "observed_at",
    "event_class",
    "action",
    "job_id",
    "target_status",
    "reason"
  ],
  "properties": {
    "source_kind": {"enum": ["gmail", "google-calendar"]},
    "source_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "minLength": 1},
    "event_class": {"type": "string", "minLength": 1},
    "action": {"enum": ["apply_update", "needs_review", "ignore"]},
    "job_id": {
      "oneOf": [
        {"type": "string", "pattern": "^JOB-[0-9]{6}$"},
        {"type": "null"}
      ]
    },
    "target_status": {
      "type": ["string", "null"],
      "enum": ["applied", "closed", "interviewing", "offer", null]
    },
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
