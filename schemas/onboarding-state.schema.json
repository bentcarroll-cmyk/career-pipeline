{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-pipeline/onboarding-state.schema.json",
  "title": "Career Pipeline onboarding state",
  "type": "object",
  "required": ["schema_version", "stage", "completed", "connectors"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {
      "enum": [
        "privacy",
        "workspace",
        "focus",
        "connectors",
        "resume",
        "interview",
        "profile",
        "packet_defaults",
        "schedule",
        "readiness",
        "active"
      ]
    },
    "completed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "connectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["decision", "capabilities"],
        "properties": {
          "decision": {"enum": ["connected", "declined", "deferred", "unavailable"]},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "receipts": {"type": "object"},
    "profile_hash": {"type": ["string", "null"]},
    "criteria_hash": {"type": ["string", "null"]},
    "mode": {"enum": ["full", "quick_start"]},
    "post_activation": {
      "type": "object",
      "properties": {
        "connector_configuration": {"enum": ["pending", "completed"]},
        "interview": {"enum": ["pending", "completed"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
