{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-pipeline/config.schema.json",
  "title": "Career Pipeline configuration",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_root",
    "timezone",
    "paths",
    "profile_approved",
    "criteria_approved",
    "connectors",
    "enabled_sources",
    "discovery_schedule",
    "packet_defaults"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "workspace_root": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "paths": {
      "type": "object",
      "required": ["profile", "sources", "jobs", "applications", "indexes", "runs", "state"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "sources": {"type": "string", "minLength": 1},
        "jobs": {"type": "string", "minLength": 1},
        "applications": {"type": "string", "minLength": 1},
        "indexes": {"type": "string", "minLength": 1},
        "runs": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profile_approved": {"type": "boolean"},
    "criteria_approved": {"type": "boolean"},
    "connectors": {"type": "object"},
    "enabled_sources": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "discovery_schedule": {
      "type": "object",
      "required": ["frequency", "weekdays", "runs_per_day", "timezone"],
      "properties": {
        "frequency": {"enum": ["weekday", "daily", "weekly", "custom"]},
        "weekdays": {"type": "array", "items": {"enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]}, "minItems": 1, "uniqueItems": true},
        "runs_per_day": {"type": "integer", "minimum": 1, "maximum": 24},
        "timezone": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "packet_defaults": {
      "type": "object",
      "required": ["resume_pages", "cover_letter_enabled", "cover_letter_pages"],
      "properties": {
        "resume_pages": {"const": 2},
        "cover_letter_enabled": {"type": "boolean"},
        "cover_letter_pages": {"enum": [0, 1]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
