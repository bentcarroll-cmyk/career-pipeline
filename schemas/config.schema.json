{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-pipeline/config.schema.json",
  "title": "Career Pipeline configuration",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_root",
    "timezone",
    "paths",
    "profile_approved",
    "criteria_approved",
    "connectors",
    "packet_defaults"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "paths": {
      "type": "object",
      "required": ["profile", "sources", "jobs", "applications", "indexes", "runs", "state"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "sources": {"type": "string", "minLength": 1},
        "jobs": {"type": "string", "minLength": 1},
        "applications": {"type": "string", "minLength": 1},
        "indexes": {"type": "string", "minLength": 1},
        "runs": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profile_approved": {"type": "boolean"},
    "criteria_approved": {"type": "boolean"},
    "connectors": {"type": "object"},
    "packet_defaults": {
      "type": "object",
      "required": ["resume_pages", "cover_letter_enabled", "cover_letter_pages"]
    }
  }
}
