{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-pipeline/discovery-run.schema.json",
  "title": "Compact discovery run evidence",
  "type": "object",
  "required": [
    "schema_version",
    "occurred_at",
    "created_job_ids",
    "duplicate_keys",
    "non_match_keys",
    "meaningful_change_job_ids",
    "filter_outcomes",
    "rejections"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "occurred_at": {"type": "string", "minLength": 1},
    "created_job_ids": {"type": "array", "items": {"$ref": "#/$defs/jobId"}},
    "duplicate_keys": {"type": "array", "items": {"type": "string"}},
    "non_match_keys": {"type": "array", "items": {"type": "string"}},
    "meaningful_change_job_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/jobId"}
    },
    "filter_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identity", "result", "decisions", "criteria_hash", "readable_criteria_sha256"],
        "properties": {
          "identity": {"$ref": "#/$defs/identity"},
          "result": {"enum": ["pass", "unknown", "confirmed_mismatch"]},
          "decisions": {
            "type": "array",
            "items": {"$ref": "#/$defs/filterDecision"}
          },
          "criteria_hash": {"$ref": "#/$defs/nullableHash"},
          "readable_criteria_sha256": {"$ref": "#/$defs/nullableHash"}
        },
        "additionalProperties": false
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identity",
          "decision",
          "disposition",
          "filter_result",
          "reason_codes",
          "reason_code_count",
          "source_receipt_reference",
          "evidence_receipt_reference",
          "criteria_hash",
          "readable_criteria_sha256",
          "assessment_hash"
        ],
        "properties": {
          "identity": {"$ref": "#/$defs/identity"},
          "decision": {"enum": ["hard_filter_rejection", "semantic_non_match"]},
          "disposition": {
            "enum": ["not_assessed", "strong_match", "worth_considering", "non_match"]
          },
          "filter_result": {"enum": ["pass", "unknown", "confirmed_mismatch"]},
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/reasonCode"}
          },
          "reason_code_count": {
            "type": "integer",
            "minimum": 1
          },
          "source_receipt_reference": {"$ref": "#/$defs/receiptReference"},
          "evidence_receipt_reference": {"$ref": "#/$defs/receiptReference"},
          "criteria_hash": {"$ref": "#/$defs/nullableHash"},
          "readable_criteria_sha256": {"$ref": "#/$defs/nullableHash"},
          "assessment_hash": {"$ref": "#/$defs/hash"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "jobId": {"type": "string", "pattern": "^JOB-[0-9]{6}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "receiptReference": {
      "type": "string",
      "pattern": "^Runs/discovery/sources/receipt-[0-9a-f]{64}\\.json$"
    },
    "nullableHash": {
      "oneOf": [
        {"$ref": "#/$defs/hash"},
        {"type": "null"}
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "candidate_key",
        "source",
        "source_record_id",
        "requisition_id",
        "employer",
        "title"
      ],
      "properties": {
        "candidate_key": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "requisition_id": {"type": ["string", "null"]},
        "employer": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "filterDecision": {
      "type": "object",
      "required": ["criterion_id", "dimension", "subject", "result", "reason_code", "rule_hash", "evidence_hash"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "dimension": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "unknown", "confirmed_mismatch"]},
        "reason_code": {"$ref": "#/$defs/reasonCode"},
        "rule_hash": {"$ref": "#/$defs/hash"},
        "evidence_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
