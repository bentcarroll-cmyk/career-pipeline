# Local secrets and environment overrides
.env
.env.*
!.env.example
*.pem
*.key

# Python and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
dist/
build/
*.egg-info/

# Generated user workspaces and application materials
user-workspaces/
Career-Workspace/
**/Applications/
**/Jobs/
**/Indexes/
**/Profile/
**/Sources/
**/Runs/
**/State/
# Keep the plugin's lowercase source-adapter packages under version control on
# case-insensitive filesystems where the workspace rules above also match them.
!src/career_pipeline/sources/
!src/career_pipeline/sources/**
!tests/unit/sources/
!tests/unit/sources/**
*.doc
*.docx
*.pdf

# Local editor and OS artifacts
.playwright-mcp/
.DS_Store
.idea/
.vscode/

# Reapply generated-Python exclusions after the source-directory exceptions.
**/__pycache__/
*.py[cod]
